# URL of the Secura Dashboard app (subdomain in prod, local Vite server in dev)
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:5173

# Lakebase Postgres on Neon (populated by `neon deploy` / `neon env pull`)
# Pooled connection string (-pooler) for application query traffic
DATABASE_URL=
# Direct (unpooled) connection string for schema migrations and admin tasks
DATABASE_URL_UNPOOLED=
