{
  "name": "secura",
  "private": true,
  "workspaces": [
    "src/apps/*",
    "src/packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @secura/www dev",
    "dev:www": "bun --filter @secura/www dev",
    "build": "bun --filter './src/apps/*' build",
    "check": "bun --workspaces run check",
    "lint": "bun lint",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "test": "bun test"
  }
}
