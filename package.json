{
  "name": "cyberledger",
  "private": true,
  "workspaces": [
    "src/apps/*",
    "src/packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @cyberledger/www dev",
    "dev:api": "bun --filter @cyberledger/api dev",
    "dev:www": "bun --filter @cyberledger/www dev",
    "start:api": "bun --filter @cyberledger/api start",
    "build": "bun --filter './src/apps/*' build",
    "check": "bun --workspaces run check",
    "lint": "bun lint",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "test": "bun test"
  },
  "dependencies": {
    "@neon/config": "^1.14.8",
    "@neon/env": "^2.1.11"
  }
}
